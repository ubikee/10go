# Entorno: development | production
NODE_ENV=development

# Puerto del API REST
PORT=4000

# Moneda por defecto (parámetro de configuración global)
CURRENCY=EUR

# Forzar el motor de persistencia: json | sqlite (opcional, por defecto según NODE_ENV)
# FORCE_PERSISTENCE=json

# Ruta de la base de datos SQLite (producción)
# DATABASE_PATH=./data/10go.sqlite
